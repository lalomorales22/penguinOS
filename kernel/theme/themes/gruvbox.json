// gruvbox dark, medium contrast. Hex values from morhetz/gruvbox.
// Roles use bg0/bg1/bg2 for ground and the bright set for anything that has to
// carry across a 2.4" panel; the neutral (non-bright) set is kept for ansi.
{
  "name": "gruvbox",
  "font": "med",

  "metrics": { "gap": 4, "border": 2, "bar_h": 14, "tab_h": 12, "radius": 0 },

  "colors": {
    "bg":               "#282828",
    "surface":          "#3c3836",
    "overlay":          "#504945",
    "text":             "#ebdbb2",
    "muted":            "#928374",
    "accent":           "#fabd2f",
    "accent_alt":       "#8ec07c",
    "ok":               "#b8bb26",
    "warn":             "#fe8019",
    "err":              "#fb4934",
    "border_focused":   "#fabd2f",
    "border_unfocused": "#504945",
    "bar_bg":           "#1d2021",
    "bar_fg":           "#ebdbb2",
    "tab_active":       "#fabd2f",
    "tab_inactive":     "#665c54"
  },

  "ansi": {
    "black":          "#282828",
    "red":            "#cc241d",
    "green":          "#98971a",
    "yellow":         "#d79921",
    "blue":           "#458588",
    "magenta":        "#b16286",
    "cyan":           "#689d6a",
    "white":          "#a89984",
    "bright_black":   "#928374",
    "bright_red":     "#fb4934",
    "bright_green":   "#b8bb26",
    "bright_yellow":  "#fabd2f",
    "bright_blue":    "#83a598",
    "bright_magenta": "#d3869b",
    "bright_cyan":    "#8ec07c",
    "bright_white":   "#ebdbb2"
  }
}
