# ESP32 (original) overrides. Appended by IDF after sdkconfig.defaults when
# CONFIG_IDF_TARGET is esp32.
#
# The original ESP32 has materially less IRAM than the C6 or the S3, and with
# Wi-Fi and NimBLE both resident penguinOS overflows it:
#
#   ld: section `.iram0.text' will not fit in region `iram0_0_seg'
#   ld: region `iram0_0_seg' overflowed by 668 bytes
#
# Moving the Wi-Fi datapath out of IRAM and into flash recovers far more than
# the 668 bytes needed. The cost is throughput on the radio - those functions
# now run from the flash cache - which is the right trade here: this is the
# tier 0 board, it serves a 20 KB page and talks to a keyboard, and it is not
# moving enough bytes for the difference to show. Do NOT copy this into the
# other targets' files: they have the IRAM to spare and would lose the speed
# for nothing.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# The CH340 bridge means the console is a real UART on the stock pins, not the
# SoC's own USB peripheral - the opposite of the C6 and S3 boards, which need
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG. The IDF default is already correct here;
# the line exists so the difference is written down rather than inferred from
# an absence.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# 240 MHz is the ESP32 maximum, and the SPI panel is clocked at 40 MHz off it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Wi-Fi buffer pools, cut to fit. MEASURED: with IDF's defaults this board
# boots to 5,612 bytes free and esp_http_server cannot start at all -
# httpd_start returns ESP_ERR_HTTPD_TASK and the web app is simply down.
#
# The boot trace is unambiguous about where 148,188 bytes go:
#   display 40,476   BLE 37,000   Wi-Fi 57,932   brain 4,544
# Wi-Fi's defaults (32 dynamic RX, 32 dynamic TX, 10 static RX, AMPDU both
# ways) are sized for a board with four times this RAM. A captive portal
# serving a 2.7 KB page does not need them.
#
# AMPDU off is the single biggest saving and the one with a real cost:
# aggregation is what makes bulk transfer fast, so throughput drops. On a board
# whose whole job is a setup page and a keyboard that is the right trade, and
# it is NOT a trade to copy to the other targets - they have the RAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# AMPDU RX BACK ON, and the reasoning that turned it off was right at the time
# and wrong now. It was disabled to free memory when this board's whole job was
# a 2.7 KB setup page and a keyboard, where aggregation buys nothing.
#
# The camera app changed that. MEASURED with it off: a 33 KB picture took 2,200
# ms of socket reads on this board against 146 ms for the same request from a
# laptop, while the pixel work - expanding and blitting - cost ONE millisecond.
# Aggregation is what makes bulk receive fast, and this board now does bulk
# receive.
#
# TX stays off: this board sends requests measured in bytes and replies measured
# in kilobytes, so TX aggregation would cost memory for nothing.
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# A bigger receive window, for the same reason. The default 5,744 bytes means
# the sender stalls waiting for acknowledgements several times per picture.
CONFIG_LWIP_TCP_WND_DEFAULT=11440
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_ESP_WIFI_NVS_ENABLED=n

# lwIP's socket table is per-socket state, and 10 is more than this board will
# ever have open: four httpd workers, the brain's one client, DNS.
CONFIG_LWIP_MAX_SOCKETS=8

# FATFS, cut to what a microSD mount on this board actually needs. Adding the
# "/sd" mount overflowed static DRAM by 56 bytes on the first build:
#
#   ld: penguinos.elf section `.dram0.bss' will not fit in region `dram0_0_seg'
#   ld: region `dram0_0_seg' overflowed by 56 bytes
#
# One volume, not two. IDF reserves per-volume state for VOLUME_COUNT whether
# or not the volumes exist, and penguinOS mounts exactly one FAT filesystem:
# "/int" is LittleFS and "/sd" is the only card. The second volume was pure
# static cost for a mount that cannot happen.
CONFIG_FATFS_VOLUME_COUNT=1

# The sector cache moves off the file and onto the volume. With SECTOR_4096
# set, a per-file cache is FOUR KILOBYTES for every open file - four open files
# is 16 KB of heap on a board that ends boot with 26 KB free, which is the
# whole budget for one directory listing. A shared per-volume window costs 4 KB
# once. The trade is that concurrent reads of different files re-fill the same
# window instead of keeping one each, so interleaved access to several files is
# slower; a card here holds pictures and recordings that are read one at a
# time, so that case is rare and the 12 KB is not.
CONFIG_FATFS_PER_FILE_CACHE=n

# The VFS registration table is static and every unused slot is DRAM, so it is
# tempting to cut. DO NOT CUT IT TO 4. That was tried and it bricked the boot:
#
#   ESP_ERROR_CHECK failed in esp_vfs_lwip_sockets_register (vfs_lwip.c:112)
#   <- esp_netif_init <- net_ensure_init <- abort() <- reboot loop
#
# The count is not "how many filesystems are mounted". LWIP'S SOCKETS ARE A VFS,
# and so is the UART console, so the real list is sockets + console + LittleFS
# on "/int" + FAT on "/sd" - four before anything optional. At MAX_COUNT=4 the
# FAT mount lost the race and returned ESP_ERR_NO_MEM ("mount_to_vfs failed
# (0x101)"), and then lwIP's own registration failed an ESP_ERROR_CHECK and
# aborted. Two unrelated-looking faults, one bad constant.
#
# Left at the IDF default of 8. IPv6 off below pays for the slack many times.
CONFIG_VFS_SUPPORT_TERMIOS=n

# mDNS keeps per-interface state for MAX_INTERFACES whether the interfaces
# exist or not. This board has exactly two netifs - the station and the setup
# SoftAP - and the third slot was static DRAM bought for an interface that
# cannot be created.
CONFIG_MDNS_MAX_INTERFACES=2

# IPv6 off. penguinOS is IPv4-only by construction - every socket it opens is
# AF_INET, the camera client included - and lwIP's v6 state is static DRAM
# whether or not an address is ever configured: destination_cache is 1,152
# bytes, neighbor_cache 544 and prefix_list 320, before the per-netif address
# arrays.
#
# This is what paid for the "/sd" FAT mount, which overflowed dram0_0_seg by 56
# bytes. Worth recording how the first six attempts went, because the method was
# wrong rather than the guesses:
#
#   FATFS_VOLUME_COUNT=1 + PER_FILE_CACHE=n   56 -> 40   (real, and worth having)
#   VFS_MAX_COUNT=4 + TERMIOS=n               40 -> 24   (and BROKE THE BOOT:
#                                             see the VFS note above)
#   MDNS_MAX_INTERFACES=2                     24 -> 24   (a limit, not an array)
#   ESP_GDBSTUB_ENABLED=n                     ignored - hidden Kconfig symbol
#   ESP_GDBSTUB_SUPPORT_TASKS=n               does not compile on xtensa
#   ESP_GDBSTUB_MAX_TASKS=4                   24 -> 24
#
# The gdbstub attempts were chasing the largest .bss symbol in the LIBRARIES -
# s_scratch, 2,368 bytes - and it shrank to 1,540 with no effect at all on the
# link, because nothing references the stub and --gc-sections drops it from the
# image entirely. Sizing symbols in an .a shows what is AVAILABLE, not what is
# LINKED. lwIP's v6 caches are in the image because lwIP is.
CONFIG_LWIP_IPV6=n

# Long filenames on FAT, and this is not a nicety - without it the card is
# WRITE-ONLY-IN-THEORY. IDF defaults to CONFIG_FATFS_LFN_NONE, which accepts
# 8.3 DOS names and nothing else, and eos_apps stages every upload as
# "<path>.part" before renaming it into place. "HELLO.TXT.part" has two dots
# and a four-character extension, so FATFS rejects it and the upload fails at
# the staging file, before a single byte is written. MEASURED: POST
# /api/fs/write?path=/sd/HELLO.TXT returned "that file could not be created"
# with a card mounted, healthy and 15 GB free.
#
# On the heap rather than the stack: the buffer is transient, taken for the
# duration of a name operation and given back, which suits a board that ends
# boot with 18 KB free far better than adding 256 bytes to every task stack
# that might touch a file.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
