# ESP32-S3 overrides. Appended by IDF after sdkconfig.defaults when
# CONFIG_IDF_TARGET is esp32s3.
#
# This board differs from the 4 MB fleet in three ways that all have to be set
# here, because sdkconfig.defaults encodes the small-board assumptions.

# 16 MB of flash, and its own partition table. sdkconfig.defaults names
# partitions.csv, which is the 4 MB layout; overriding the filename is what
# keeps the two tables independent instead of one file trying to serve both.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16mb.csv"

# 8 MB of PSRAM, and it is OCTAL on the ESP32-S3R8. Quad mode does not merely
# run slower on this part, it fails to initialise, so the mode is not a free
# choice. MEASURED with these settings: esp_psram reports the full 8388608
# bytes and a 2 x 110080 B double buffer allocates successfully - which is what
# makes this the only board in the fleet that can run render tier 2.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Let heap_caps_malloc fall back to PSRAM for large blocks, but keep small
# allocations internal: PSRAM is not DMA-capable for every peripheral and the
# panel wants DMA-able buffers.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Holds this many bytes of INTERNAL memory back when PSRAM joins the heap, so
# they stay available to MALLOC_CAP_DMA/MALLOC_CAP_INTERNAL requests. The IDF
# default is 32768; this board has the least internal DRAM in the fleet
# (~120 KB of heap tail against the C6's ~198 KB) and spends 51,200 bytes of it
# on the panel's two 320x40x2 band buffers before Wi-Fi initialises at all.
#
# HONEST SCOPE. This was originally credited with fixing a captive portal that
# associated, took a DHCP lease and then failed every HTTP response with EAGAIN.
# It was not the fix. That was a routing bug - setup mode served the 20 KB run
# application instead of the 2,756-byte built-in panel, and 20 KB is the only
# response this server can produce that exceeds CONFIG_LWIP_TCP_SND_BUF_DEFAULT
# and can therefore block send() for a full timeout. See eos_web_path.h.
#
# It is kept because it is still worth having: esp_psram_extram_reserve_dma_pool
# registers the reserve as its own multi_heap, so a large contiguous DMA request
# late in a fragmented run can succeed there when the main heap cannot serve it.
# It does NOT, on IDF 5.5.5, fence the memory off from ordinary malloc() - the
# pool advertises INTERNAL and DEFAULT, so malloc() drains it before falling
# back to PSRAM. The total internal memory reachable before PSRAM fallback is
# unchanged, and any comment claiming otherwise is wrong.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072

# Native USB, no bridge chip - same situation as the C6. Without this the board
# boots correctly and looks dead, because the stock UART0 console prints to
# pins nobody has wired.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 240 MHz is the S3 maximum. The SPI panel is clocked at 40 MHz off it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The S3 is the first dual-core board here (chip.cores 2 in the profile).
# Nothing is pinned yet; the OS is written single-core-safe and the second core
# is headroom for the tier 2 compositor rather than something relied upon.
