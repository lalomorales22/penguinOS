# ESP32-C6 overrides. Appended by IDF after sdkconfig.defaults when
# CONFIG_IDF_TARGET is esp32c6.
#
# The Waveshare ESP32-C6-LCD-1.3 has no USB-to-UART bridge chip. Its
# flashing.usb_bridge is "usb_serial_jtag" and /dev/cu.usbmodem101 is the SoC's
# own USB peripheral, so the stock UART0 console prints to pins nobody has
# wired. Without this the board boots correctly and looks dead.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 160 MHz is the C6 maximum and the SPI panel is clocked at 40 MHz off it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# The C6 is single core (chip.cores 1 in the profile). Nothing to pin here; the
# line exists so a future dual-core board's file is an obvious place to differ.

# ---------------------------------------------------------------------- lwIP
# IPv6 off. It saves 1,616 bytes of heap (254,992 -> 256,608 free at app_main,
# measured on this board) and matches esp32 and esp32c5, which both set it.
#
# IT WAS ADDED FOR A DIFFERENT REASON AND DID NOT FIX THAT REASON. Opening the
# board's own name from a Mac takes five seconds:
#
#   curl -4  0.054 s   (dns 0.005 s)      the page itself is 50 ms
#   curl -6  5.18  s
#   default  5.06  s   (dns 5.007 s, every time, never varying)
#
# A client resolving penguin-four.local asks for A and AAAA together, gets the
# A immediately, and then waits out the full five-second mDNS timeout on the
# AAAA that never arrives. The theory was that a board with no IPv6 at all
# would say so - mDNS has an NSEC record meaning "I have no address of that
# type" - and that the AAAA question would stop hanging.
#
# MEASURED AFTER THIS LINE WENT IN, on a confirmed-new image: still 5.010 s.
# IDF's mDNS responder does not send the NSEC either way, so the question hangs
# regardless and the client's timeout is the client's to spend. Turning IPv6
# off does not shorten it.
#
# So: the delay is real, it is not fixed here, and the workaround is the IP
# address, which resolves instantly. Anyone tempted to try this again for the
# latency should read this paragraph first and go and look at the mDNS
# component's NSEC handling instead.
CONFIG_LWIP_IPV6=n

# ---------------------------------------------------------------- partitions
# ONE app slot, overriding the two-slot partitions.csv that 4 MB boards get by
# default. MEASURED: this target's image is 1,855,280 bytes (C6) / 1,888,512
# (C5) against a 1,703,936-byte OTA slot - it does not fit, and the ~275 KB it
# exceeds the ESP32's image by is libnet80211, libpp and libbt, which is the
# radio itself. See partitions-1slot.csv for why shrinking the filesystem
# instead is not a trade worth making.
#
# So these boards are updated over USB and say so: /api/ota/* answers "this
# board cannot update itself over the web", which is true and better than
# offering a button that fails at the end of a minute-long upload.
#
# A 16 MB board on this target overrides this again in its own
# sdkconfig.board.<id> - the LILYGO T-Display C5 does exactly that and DOES get
# two slots, because at 16 MB a slot is 4 MB and the image uses a third of it.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-1slot.csv"
