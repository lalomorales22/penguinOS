# ESP32-C6 overrides. Appended by IDF after sdkconfig.defaults when
# CONFIG_IDF_TARGET is esp32c6.
#
# The Waveshare ESP32-C6-LCD-1.3 has no USB-to-UART bridge chip. Its
# flashing.usb_bridge is "usb_serial_jtag" and /dev/cu.usbmodem101 is the SoC's
# own USB peripheral, so the stock UART0 console prints to pins nobody has
# wired. Without this the board boots correctly and looks dead.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 160 MHz is the C6 maximum and the SPI panel is clocked at 40 MHz off it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# The C6 is single core (chip.cores 1 in the profile). Nothing to pin here; the
# line exists so a future dual-core board's file is an obvious place to differ.
