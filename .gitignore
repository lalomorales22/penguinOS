# macOS
.DS_Store

# Board headers are derived from boards/*.json. Regenerate with:
#   python3 tools/gen_board_header.py --all
boards/generated/

# ESP-IDF build output. NOTE the glob: penguinOS builds one directory PER BOARD
# (build-lafvin, build-s3, ...) because a build dir is target-specific, so a bare
# "build/" matched only the first board's and quietly tracked every other board's
# object files and static libraries.
build/
build-*/
firmware/build/
firmware/build-*/
# Each build dir owns its own sdkconfig - see tools/flash.sh. A shared one at the
# project root breaks the moment two silicon targets are in play.
sdkconfig
sdkconfig.old
firmware/sdkconfig
firmware/sdkconfig.old
managed_components/
.cache/

# Compiled objects and images
*.o
*.elf
*.map
design/.dump

# Editors
.vscode/
.idea/
*.swp

# Per-board bring-up apps are real IDF projects; their build output is not
boards/*/probe/build/
boards/*/probe/sdkconfig
boards/*/probe/managed_components/
boards/*/probe/dependencies.lock

# Factory firmware read off a board before penguinOS overwrote it. Keep these -
# they are the only thing on a board that cannot be recreated - but never commit
# them: they are the VENDOR'S proprietary firmware, and publishing a repo full
# of Waveshare's and LAFVIN's code is republishing someone else's work.
#
# The sha256 of each is recorded in that board's profile, so a restore is still
# verifiable without the blob being in git. Local copies also live in
# ../factory-backups/.
boards/*/backup/*.bin
